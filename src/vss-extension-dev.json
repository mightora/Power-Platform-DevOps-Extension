{
    "manifestVersion": 1,
    "id": "mightora-power-platform-devOps-extension-dev",
    "name": "DEV 2.2.21 - Power Platform Documentation Extension",
    "version": "2.2.21",
    "publisher": "mightoraio",
    "targets": [
        {
            "id": "Microsoft.VisualStudio.Services"
        }
    ],
    "description": "Power Platform Documentation Extension, allows users of this extension to quickly and easily document out their solutions in to easy to read documentation.",
    "categories": [
        "Azure Pipelines"
    ],
    "icons": {
        "default": "images/mightora_io_icon_260x260.png"
    },
    "content": {
        "details": {
            "path": "details.md"
        },
        "pricing": {
            "path": "pricing.md"
        }
    },
    "links": {
        "home": {
            "uri": "https://mightora.io"
        },
        "getstarted": {
            "uri": "https://mightora.io"
        },
        "learn": {
            "uri": "https://mightora.io"
        },
        "support": {
            "uri": "https://mightora.io"
        },
        "repository": {
            "uri": "https://mightora.io"
        },
        "issues": {
            "uri": "https://mightora.io"
        }
    },
    "repository": {
        "type": "git",
        "uri": "https://github.com/mightora"
    },
    "files": [
        {
            "path": "tasks/documentSolutionTables",
            "packagePath": "tasks/documentSolutionTables"
        },
        {
            "path": "tasks/documentTableRelationships",
            "packagePath": "tasks/documentTableRelationships"
        },
        {
            "path": "tasks/documentTableRelationshipsAsERDiagram",
            "packagePath": "tasks/documentTableRelationshipsAsERDiagram"
        },
        {
            "path": "tasks/solutionXMLNodeUpdater",
            "packagePath": "tasks/solutionXMLNodeUpdater"
        },
        {
            "path": "tasks/solutionXMLNodeAttributeUpdater",
            "packagePath": "tasks/solutionXMLNodeAttributeUpdater"
        },
        {
            "path": "tasks/documentRoles",
            "packagePath": "tasks/documentRoles"
        },
        {
            "path": "tasks/convertMarkdownToDocx",
            "packagePath": "tasks/convertMarkdownToDocx"
        },
        {
            "path": "tasks/convertConvertInlineDiagrams",
            "packagePath": "tasks/convertConvertInlineDiagrams"
        },
        {
            "path": "tasks/documentSolutionManifest",
            "packagePath": "tasks/documentSolutionManifest"
        },
        {
            "path": "tasks/documentOptionSets",
            "packagePath": "tasks/documentOptionSets"
        },
        {
            "path": "tasks/documentWorkflows",
            "packagePath": "tasks/documentWorkflows"
        }
    ],
    "contributions": [
        {
            "id": "mightora-documentSolutionTables-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/documentSolutionTables"
            }
        },
        {
            "id": "mightora-documentTableRelationships-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/documentTableRelationships"
            }
        },
        {
            "id": "mightora-powerplatform-documentationgenerator-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/documentTableRelationshipsAsERDiagram"
            }
        },
        {
            "id": "mightora-solutionXMLNodeUpdater-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/solutionXMLNodeUpdater"
            }
        },
        {
            "id": "mightora-solutionXMLNodeAttributeUpdater-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/solutionXMLNodeAttributeUpdater"
            }
        },
        {
            "id": "mightora-documentRoles-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/documentRoles"
            }
        },
        {
            "id": "mightora-documentSolutionManifest-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/documentSolutionManifest"
            }
        },
        {
            "id": "mightora-documentOptionSets-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/documentOptionSets"
            }
        },
        {
            "id": "mightora-documentWorkflows-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/documentWorkflows"
            }
        },
        {
            "id": "mightora-convertMarkdownToDocx-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/convertMarkdownToDocx"
            }
        },
        {
            "id": "mightora-convertConvertInlineDiagrams-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/convertConvertInlineDiagrams"
            }
        }
    ]
}